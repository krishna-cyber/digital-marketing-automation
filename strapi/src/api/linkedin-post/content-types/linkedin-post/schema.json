{
  "kind": "collectionType",
  "collectionName": "linkedin_posts",
  "info": {
    "singularName": "linkedin-post",
    "pluralName": "linkedin-posts",
    "displayName": "linkedin_article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "richtext"
    },
    "linkedin_post_id": {
      "type": "string"
    },
    "linkedin_post_url": {
      "type": "string"
    },
    "post_status": {
      "type": "string"
    },
    "media_files": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "media_type": {
      "type": "string"
    },
    "visibility": {
      "type": "string"
    },
    "post_type": {
      "type": "string"
    },
    "event_id": {
      "type": "uid"
    },
    "image_alt_text": {
      "type": "text"
    },
    "image_prompt": {
      "type": "text"
    },
    "start_date": {
      "type": "datetime"
    },
    "end_date": {
      "type": "datetime"
    }
  }
}
